# Direct GPT-5.6 Sol control. No Switchyard plugin is loaded; Relay retains
# pricing and observability around the managed Hermes LLM lifecycle.
version = 1

[[components]]
kind = "pricing"
enabled = true

[[components.config.sources]]
type = "inline"

[components.config.sources.catalog]
version = 1

[[components.config.sources.catalog.entries]]
provider = "openai"
model_id = "openai/openai/gpt-5.6-sol"
currency = "USD"
unit = "per_token"
pricing_as_of = "2026-08-26"
pricing_source = "OpenRouter model catalog API (https://openrouter.ai/api/v1/models)"

[components.config.sources.catalog.entries.rates]
input_per_million = 2.0
output_per_million = 10.0
cache_read_per_million = 0.2
cache_write_per_million = 2.5

[components.config.sources.catalog.entries.prompt_cache]
read_accounting = "included_in_prompt_tokens"

[[components]]
kind = "observability"
enabled = true

[components.config]
version = 3

[components.config.atof]
enabled = true

[[components.config.atof.sinks]]
type = "file"
mode = "append"
output_directory = "/logs/agent/direct-hermes/relay"
filename = "trajectory.atof.jsonl"

[components.config.atif]
enabled = true
agent_name = "Hermes"
agent_version = "@HERMES_COMMIT@"
model_name = "openai/openai/gpt-5.6-sol"
output_directory = "/logs/agent/direct-hermes/relay/atif"
filename_template = "trajectory-{session_id}.atif.json"

[components.config.opentelemetry]
enabled = true

[[components.config.opentelemetry.endpoints]]
type = "openinference"
transport = "http_binary"
endpoint = "@OPENINFERENCE_ENDPOINT@"
service_name = "harbor-hermes-switchyard"
service_namespace = "nemo-relay-examples"
instrumentation_scope = "harbor-hermes-switchyard"
timeout_millis = 5000

[components.config.opentelemetry.endpoints.resource_attributes]
"openinference.project.name" = "@PHOENIX_PROJECT@"
"evaluation.cohort" = "@EVAL_COHORT@"
