{
  "name": "nemo-relay-node",
  "version": "1.0.0",
  "description": "Node.js bindings for the NeMo Relay agent runtime.",
  "keywords": [
    "agents",
    "ai",
    "llm",
    "middleware",
    "nemo-relay",
    "observability",
    "runtime",
    "tools"
  ],
  "homepage": "https://github.com/NVIDIA/NeMo-Relay#readme",
  "bugs": {
    "url": "https://github.com/NVIDIA/NeMo-Relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NVIDIA/NeMo-Relay.git",
    "directory": "crates/node"
  },
  "author": "NVIDIA Corporation & Affiliates",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./typed": {
      "types": "./dist/typed.d.ts",
      "default": "./dist/typed.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./adaptive": {
      "types": "./dist/adaptive.d.ts",
      "default": "./dist/adaptive.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "default": "./dist/observability.js"
    },
    "./pii_redaction": {
      "types": "./dist/pii_redaction.d.ts",
      "default": "./dist/pii_redaction.js"
    },
    "./model_pricing": {
      "types": "./dist/model_pricing.d.ts",
      "default": "./dist/model_pricing.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    }
  },
  "typesVersions": {
    "*": {
      "typed": [
        "dist/typed.d.ts"
      ],
      "plugin": [
        "dist/plugin.d.ts"
      ],
      "adaptive": [
        "dist/adaptive.d.ts"
      ],
      "observability": [
        "dist/observability.d.ts"
      ],
      "pii_redaction": [
        "dist/pii_redaction.d.ts"
      ],
      "model_pricing": [
        "dist/model_pricing.d.ts"
      ],
      "diagnostics": [
        "dist/diagnostics.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "napi": {
    "binaryName": "nemo-relay",
    "constEnum": false,
    "runtimeStringEnum": true,
    "dtsHeaderFile": "binding-types.d.ts",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "build-debug": "node scripts/build.mjs",
    "check:docstrings": "node ../../scripts/lint/check_public_docstrings.mjs node",
    "check:docstrings:all": "node ../../scripts/lint/check_public_docstrings.mjs all",
    "format": "prettier --write \"binding-types.d.ts\" \"{scripts,ts,tests}/**/*.{mjs,cjs,js,mts,cts,ts,tsx}\"",
    "format:check": "prettier --check \"binding-types.d.ts\" \"{scripts,ts,tests}/**/*.{mjs,cjs,js,mts,cts,ts,tsx}\"",
    "precommit:format": "node ../../scripts/lint/prettier-precommit.mjs",
    "precoverage": "npm run build-debug -- --features __skip-implicit-config",
    "pretest": "npm run build-debug -- --features __skip-implicit-config",
    "test": "node --test --test-force-exit tests/*.mjs",
    "coverage": "c8 --reporter=text --reporter=json-summary --reporter=cobertura --reports-dir coverage node --test --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml tests/*.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^24.0.0",
    "c8": "^11.0.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": ">=5.7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "license": "Apache-2.0"
}
